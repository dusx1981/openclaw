# PostgreSQL Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5434
POSTGRES_DB=meichao_ecom
POSTGRES_USER=meichao
POSTGRES_PASSWORD=meichao_secret

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=
REDIS_DB=0

# API Credentials (to be filled)
# Taobao Open Platform (required for real data collection)
# Get credentials from: https://open.taobao.com/
TAOBAO_APP_KEY=
TAOBAO_APP_SECRET=
# Optional: Access token for user-authorized APIs
TAOBAO_ACCESS_TOKEN=
# Optional: Custom API endpoint (defaults to https://eco.taobao.com/router/rest)
# TAOBAO_API_ENDPOINT=
# Optional: Request timeout in milliseconds (defaults to 30000)
# TAOBAO_API_TIMEOUT=

# Amazon SP-API (Selling Partner API)
# Required for Amazon product data collection
# Get credentials from: https://developer-docs.amazon.com/sp-api/
# 
# LWA (Login with Amazon) credentials:
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REFRESH_TOKEN=
#
# AWS region (eu, na, fe)
AMAZON_REGION=na
#
# Optional: Marketplace ID (defaults to US marketplace: ATVPDKIKX0DER)
# Find your marketplace ID: https://developer-docs.amazon.com/sp-api/docs/marketplace-ids
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER
#
# Optional: API timeout in milliseconds (defaults to 30000)
# AMAZON_API_TIMEOUT=30000

# Third-party API Keys
JUSHUTA_API_KEY=
CHANMAMA_API_KEY=

# Open Search Providers (fallback when primary APIs fail)
# Bing Search API - Free tier: 1000 calls/month
# Get key from: https://azure.microsoft.com/en-us/services/cognitive-services/bing-web-search-api/
BING_API_KEY=
# Optional: Bing Custom Search Config ID for shopping-focused results
BING_CUSTOM_CONFIG_ID=

# Tavily API - Already configured via OpenClaw's tavily plugin
# See: plugins.entries.tavily.config.webSearch.apiKey

# ========================================
# Additional E-commerce Platforms
# ========================================

# 1688 (Alibaba Wholesale Platform)
# Get credentials from: https://open.1688.com/
ALIBABA_1688_APP_KEY=
ALIBABA_1688_APP_SECRET=
# Optional: Custom API endpoint (defaults to https://gw.open.1688.com/openapi/)
# ALIBABA_1688_API_URL=
# Optional: Request timeout in milliseconds (defaults to 30000)
# ALIBABA_1688_API_TIMEOUT=

# JD (JingDong)
# Get credentials from: https://open.jd.com/
JD_APP_KEY=
JD_APP_SECRET=
# Optional: Custom API endpoint (defaults to https://api.jd.com/routerjson)
# JD_API_URL=
# Optional: Request timeout in milliseconds (defaults to 30000)
# JD_API_TIMEOUT=

# Pinduoduo
# Get credentials from: https://open.pinduoduo.com/
PINDUODUO_CLIENT_ID=
PINDUODUO_CLIENT_SECRET=
# Optional: Custom API endpoint (defaults to https://gw-api.pinduoduo.com/api/router)
# PINDUODUO_API_URL=
# Optional: Request timeout in milliseconds (defaults to 30000)
# PINDUODUO_API_TIMEOUT=

# Douyin (TikTok E-commerce)
# Get credentials from: https://developer.open-douyin.com/
DOUYIN_APP_ID=
DOUYIN_APP_SECRET=
# Optional: Custom API endpoint (defaults to https://developer.toutiao.com/api/)
# DOUYIN_API_URL=
# Optional: Request timeout in milliseconds (defaults to 30000)
# DOUYIN_API_TIMEOUT=

# Shopee
# Get credentials from: https://open.shopee.com/
SHOPEE_PARTNER_ID=
SHOPEE_PARTNER_KEY=
# Optional: Shopee region/site (defaults to SG)
# SHOPEE_REGION=SG
# Optional: Custom API endpoint (defaults to https://partner.shopeemobile.com/api/v2/)
# SHOPEE_API_URL=
# Optional: Request timeout in milliseconds (defaults to 30000)
# SHOPEE_API_TIMEOUT=

# AliExpress
# Get credentials from: https://developers.aliexpress.com/
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
# Optional: Custom API endpoint (defaults to https://api.aliexpress.com/)
# ALIEXPRESS_API_URL=
# Optional: Request timeout in milliseconds (defaults to 30000)
# ALIEXPRESS_API_TIMEOUT=

# ========================================
# Additional E-commerce Platforms (New)
# ========================================

# TikTok Shop (TK)
# Get credentials from: https://partner.tiktokshop.com/
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
# Optional: Custom API endpoint (defaults to https://open-api.tiktokglobalshop.com/)
# TIKTOK_SHOP_API_URL=
# Optional: Request timeout in milliseconds (defaults to 30000)
# TIKTOK_SHOP_API_TIMEOUT=

# Lazada
# Get credentials from: https://open.lazada.com/
LAZADA_APP_KEY=
LAZADA_APP_SECRET=
# Optional: Custom API endpoint (defaults to https://api.lazada.com.my/rest)
# LAZADA_API_URL=
# Optional: Request timeout in milliseconds (defaults to 30000)
# LAZADA_API_TIMEOUT=

# TUME
# Get credentials from: https://open.tume.com/
TUME_APP_KEY=
TUME_APP_SECRET=
# Optional: Custom API endpoint (defaults to https://api.tume.com/)
# TUME_API_URL=
# Optional: Request timeout in milliseconds (defaults to 30000)
# TUME_API_TIMEOUT=

# Tmall (天猫) - Uses Taobao API credentials
# Uses TAOBAO_APP_KEY and TAOBAO_APP_SECRET
# Distinguished by user_type field in API response

# TaoGongChang (淘工厂) - Uses 1688 API credentials
# Uses ALIBABA_1688_APP_KEY and ALIBABA_1688_APP_SECRET
# Distinguished by product tags in API response