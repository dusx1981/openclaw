{
  "$schema": "./config.schema.json",
  "default": {
    "primary": "taobao/official_api",
    "fallbacks": ["taobao/third_party_api", "taobao/skill_crawler"]
  },
  "platforms": {
    "taobao": {
      "primary": "taobao_official_api",
      "fallbacks": ["taobao_third_party", "taobao_crawler"]
    },
    "amazon": {
      "primary": "amazon_sp_api",
      "fallbacks": ["amazon_product_api"]
    },
    "douyin": "douyin/skill_crawler",
    "1688": {
      "primary": "1688/official_api",
      "fallbacks": ["1688/skill_crawler"]
    },
    "shopee": {
      "primary": "shopee/official_api",
      "fallbacks": ["shopee/third_party_api"]
    },
    "pinduoduo": {
      "primary": "pinduoduo/official_api",
      "fallbacks": ["pinduoduo/skill_crawler"]
    },
    "jd": {
      "primary": "jd/official_api",
      "fallbacks": ["jd/third_party_api"]
    },
    "aliexpress": {
      "primary": "aliexpress/official_api",
      "fallbacks": ["aliexpress/third_party_api"]
    }
  },
  "settings": {
    "maxFallbackSources": 3,
    "enableStaleCache": true,
    "staleCacheMaxAge": 3600000,
    "circuitBreaker": {
      "enabled": true,
      "failureThreshold": 5,
      "openDuration": 30000
    }
  }
}
